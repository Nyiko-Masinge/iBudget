{
  "name": "ibudget-workspace",
  "private": true,
  "workspaces": [
    "apps/mobile",
    "packages/finance-core",
    "packages/data-access"
  ],
  "scripts": {
    "start": "npm run start --workspace @ibudget/mobile",
    "web": "npm run web --workspace @ibudget/mobile",
    "android": "npm run android --workspace @ibudget/mobile",
    "ios": "npm run ios --workspace @ibudget/mobile",
    "typecheck": "npm run typecheck --workspace @ibudget/mobile",
    "lint": "eslint apps packages",
    "test": "npm run test --workspace @ibudget/mobile",
    "supabase:start": "npx supabase start --workdir backend",
    "supabase:status": "npx supabase status --workdir backend"
  },
  "devDependencies": {
    "eslint": "^9.0.0",
    "eslint-config-expo": "~9.2.0"
  }
}
