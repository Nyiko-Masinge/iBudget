{
  "name": "ibudget-workspace",
  "private": true,
  "workspaces": ["apps/mobile", "packages/finance-core", "packages/data-access"],
  "scripts": {
    "start": "npm run start --workspace @ibudget/mobile",
    "web": "npm run web --workspace @ibudget/mobile",
    "android": "npm run android --workspace @ibudget/mobile",
    "ios": "npm run ios --workspace @ibudget/mobile",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint apps packages",
    "test": "jest --watchAll=false",
    "supabase:start": "supabase start --workdir backend/supabase",
    "supabase:status": "supabase status --workdir backend/supabase"
  },
  "devDependencies": {"eslint":"^9.0.0", "eslint-config-expo":"~9.2.0", "jest":"^29.7.0", "jest-expo":"~53.0.0", "typescript":"~5.8.3", "@types/react":"~19.0.10"}
}
