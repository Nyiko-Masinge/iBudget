{
  "expo": {
    "name": "iBudget",
    "slug": "ibudget",
    "scheme": "ibudget",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "web": {
      "bundler": "metro",
      "name": "iBudget"
    }
  }
}
